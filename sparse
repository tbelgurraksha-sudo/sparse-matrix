#include <stdio.h>


struct sparsematrix
{
    int row;
    int col;
    int value;
};
typedef struct sparsematrix MATRIX;

int main()
{
    int m,n,count,k,item,key,i,j;
    MATRIX a[100];
    printf("enter the number of rows:");
    printf("%d",&m);
    printf("enter the number of columns:");
    printf("%d",&n);

    a[0].row=m;
    a[0].col=n;
    count=0;
    k=1;
    printf("\n\n enter elements of matrix");
    for(i=0;i<m;i++)
        {
            for(j=0;j<n;j++)
                {
                    scanf("%d",&item);
                        if(item!=0)
                    {
                        a[k].row=i;
                        a[k].col=j;
                        a[k].value=item;
                        k++;
                        count++;
                    }
                }
        }
    a[0].value=count;
    printf("enter element to be searched\n");
    scanf("%d",&key);
    for(i=1;i<=a[0].value;i++)
        {
            if(a[i].value==key)
            {
                printf("element found in row %d and column    %d",a[i].row,a[i].col);
                return 0;
            }
        }
    printf("element not found\n");
    return 0;
                
          

    
}
